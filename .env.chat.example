# Backend only. Use an OCI Customer Secret Key pair, never a frontend NEXT_PUBLIC_ variable.
OCI_ACCESS_KEY=
OCI_SECRET_KEY=
OCI_NAMESPACE=
OCI_REGION=ap-hyderabad-1
OCI_BUCKET=fileuploads

# Per-file size in MiB (1..100), and files per message (1..20).
CHAT_MAX_FILE_SIZE_MB=10
CHAT_MAX_ATTACHMENTS=8
CHAT_ALLOWED_ORIGINS=http://localhost:3000
